{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=ClinicSystemDB;Integrated Security=True;TrustServerCertificate=True"

  },
  "JwtSettings": {
    "Issuer": "ClinicSystem.API",
    "Audience": "ClinicSystem.Client",
    "ExpiryMinutes": 60
  },
  "ClinicSchedule": {

    "WorkingDays": [

      "Saturday",

      "Sunday",

      "Monday",

      "Tuesday",

      "Wednesday",

      "Thursday"

    ],

    "OpeningTime": "16:00",

    "ClosingTime": "21:00",

    "SlotIntervalMinutes": 30,

    "BookingWindowDays": 14,

    "ArrivalBeforeMinutes": 10

  }

}

